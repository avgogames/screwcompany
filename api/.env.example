# API service settings. Copy to api/.env and fill in your own TEST values.
# Never commit real secrets.

# Postgres connection string. This default matches compose.yaml (podman compose up -d).
# For hosted Postgres (Neon, Supabase, Railway, RDS...) paste the URL they give you, usually with ?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/screwcompany"

# Session signing secret (required in production, 32+ chars, e.g. `openssl rand -hex 32`)
SESSION_SECRET=""

# Port the API listens on
PORT=4000

# Public URL of the website (used for Stripe redirect URLs)
SITE_URL="http://localhost:3000"

# Twilio Verify (SMS one-time codes). Leave empty in development to use the code 123456.
#   https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# Stripe test keys (sk_test_..., whsec_...).
#   https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
